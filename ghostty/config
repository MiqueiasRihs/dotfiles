# ==========================================
# APARÊNCIA
# ==========================================
theme = Ayu
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 10

# Ligatures
font-feature = calt
font-feature = liga

background-opacity = 0.9
background-blur-radius = 20

# ==========================================
# COMPORTAMENTO
# ==========================================
cursor-style = block

open_links = true
copy_on_select = true
cursor-style-blink = true
mouse-hide-while-typing = true

scrollback_lines = 100000
keybind = ctrl+l=clear_screen

# ==========================================
# JANELA E TAMANHO
# ==========================================
# Configuração corrigida (auto ou client)
window-decoration = auto

# Confirmação ao fechar (false = não pergunta)
confirm-close-surface = false

# TAMANHO PADRÃO (Colunas x Linhas)
# 130 colunas é ótimo para dividir a tela (split) e codar
# 40 linhas dá uma boa altura vertical
window-width = 120
window-height = 30

# ==========================================
# ATALHOS
# ==========================================
# Colar sem Shift
keybind = ctrl+v=paste_from_clipboard

# ==========================================
# ATALHOS DE DIVISÃO
# ==========================================
# Dividir para a DIREITA (Right)
keybind = ctrl+shift+r=new_split:right

# Dividir para BAIXO (Down)
keybind = ctrl+shift+d=new_split:down

# Fechar o painel atual (Close)
keybind = ctrl+shift+w=close_surface

# ==========================================
# NAVEGAÇÃO ENTRE PAINÉIS
# ==========================================
# Usando Ctrl + Shift + Setas para mudar o foco
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom

# ==========================================
# REDIMENSIONAR PAINÉIS
# ==========================================
# Alt + Setas para aumentar/diminuir
keybind = alt+up=resize_split:up,10
keybind = alt+down=resize_split:down,10
keybind = alt+left=resize_split:left,10
keybind = alt+right=resize_split:right,10

command = /usr/bin/zsh